 <!DOCTYPE html>
<html lang="en">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width,initial-scale=1">
<title>Vision Point Poker Chips</title>
<style>
/* ================= POKER CHIP (copy from here) ================= */
.chip {
  --size: 120px;                 /* change to resize the chip */
  --base: #c43a2c;               /* main chip color          */
  --stripe: #fbf3e4;             /* edge stripe color        */
  --face: #fbf3e4;               /* center face color        */
  --txt: #a12c20;                /* number color             */
  --edge: #7a1f17;               /* darker side/thickness    */

  position: relative;
  width: var(--size);
  height: var(--size);
  border-radius: 50%;
  display: inline-grid;
  place-items: center;
  align-content: center;
  line-height: 1;
  user-select: none;
  color: var(--txt);
  font-family: system-ui, -apple-system, "Segoe UI", sans-serif;
  background:
    /* center face + colored ring around it */
    radial-gradient(circle, var(--face) 0 47%, var(--base) 48% 56%, transparent 57%),
    /* 8 rectangular edge stripes */
    repeating-conic-gradient(var(--base) 0 30deg, var(--stripe) 30deg 45deg);
  box-shadow:
    0 calc(var(--size) * .04) 0 var(--edge),          /* chip thickness */
    0 calc(var(--size) * .08) calc(var(--size) * .1) rgba(0,0,0,.45),
    inset 0 0 0 calc(var(--size) * .03) rgba(0,0,0,.15);
}
/* dashed inner ring */
.chip::before {
  content: "";
  position: absolute;
  inset: 22%;
  border-radius: 50%;
  border: calc(var(--size) * .015) dashed var(--base);
  opacity: .55;
}
/* subtle glossy highlight */
.chip::after {
  content: "";
  position: absolute;
  inset: 0;
  border-radius: 50%;
  background: linear-gradient(150deg, rgba(255,255,255,.28) 0%, rgba(255,255,255,0) 45%);
  pointer-events: none;
}
.chip b {
  position: relative; z-index: 1;
  font-weight: 800;
  font-size: calc(var(--size) * .32);
  letter-spacing: -.02em;
}
.chip i {
  position: relative; z-index: 1;
  font-style: normal;
  font-weight: 700;
  font-size: calc(var(--size) * .12);
  letter-spacing: .12em;
  margin-top: calc(var(--size) * .02);
  opacity: .8;
}

/* ---- denominations ---- */
.chip.vp1  { --base:#e9e4d8; --stripe:#2f6db5; --face:#fbf8f1; --txt:#24486f; --edge:#a8a294; }
.chip.vp5  { --base:#c43a2c; --stripe:#fbf3e4; --face:#fbf3e4; --txt:#a12c20; --edge:#7a1f17; }
.chip.vp10 { --base:#1f4fa0; --stripe:#fbf3e4; --face:#fbf3e4; --txt:#1b4189; --edge:#122f61; }
/* ================= (copy to here) ================= */


/* demo page only */
body {
  margin: 0; min-height: 100vh;
  display: flex; flex-direction: column; align-items: center; justify-content: center; gap: 48px;
  background: radial-gradient(ellipse at 50% 40%, #2f9460, #124a2b);
  font-family: system-ui, sans-serif; color: #f3efe6;
}
.row { display: flex; gap: 48px; flex-wrap: wrap; justify-content: center; align-items: end; }
.item { display: flex; flex-direction: column; align-items: center; gap: 18px; font-weight: 600; letter-spacing: .05em; }
.small .chip { --size: 56px; }
</style>
</head>
<body>

  <div class="row">
    <div class="item"><div class="chip vp1"><b>1</b><i>VP</i></div>1 Vision Point</div>
    <div class="item"><div class="chip vp5"><b>5</b><i>VP</i></div>5 Vision Points</div>
    <div class="item"><div class="chip vp10"><b>10</b><i>VP</i></div>10 Vision Points</div>
  </div>

  <!-- same chips at a smaller size -->
  <div class="row small">
    <div class="chip vp1"><b>1</b><i>VP</i></div>
    <div class="chip vp5"><b>5</b><i>VP</i></div>
    <div class="chip vp10"><b>10</b><i>VP</i></div>
  </div>

</body>
</html>
